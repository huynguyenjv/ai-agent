# =============================================================================
# AI Coding Agent — DEPLOY .env (Ubuntu + docker compose)
# =============================================================================
# Usage:
#   cp .env.deploy .env
#   # Điền các mục [REQUIRED] + kiểm tra [CHECK]
#   docker compose up -d
#
# Legend:
#   [REQUIRED] — phải set trước khi chạy
#   [CHECK]    — có default, xem lại cho đúng môi trường
#   [OPT]      — tuỳ chọn
# =============================================================================


# ---- Server (ai-agent container) ----------------------------------------
# [REQUIRED] API key cho mọi request /review/analyze, /v1/chat/completions, /index
#   Sinh bằng: openssl rand -hex 32
API_KEY=CHANGE_ME_openssl_rand_hex_32

# [CHECK] Bind address trong container — để 0.0.0.0
HOST=0.0.0.0

# [CHECK] Port nội bộ container; compose map ${PORT}:${PORT} ra host
PORT=8080

# [CHECK] INFO cho prod, DEBUG khi troubleshoot
LOG_LEVEL=INFO

# [CHECK] json → log structured (khuyến nghị cho prod/ELK); text cho dev
LOG_FORMAT=json

# [REQUIRED] Restrict CORS. Comma-separated. KHÔNG để "*" ở prod.
#   Ví dụ: https://gitlab.yourcorp.com,https://ide.yourcorp.com
CORS_ORIGINS=*


# ---- vLLM (external) ----------------------------------------------------
# [REQUIRED] URL tới vLLM đã chạy sẵn (image riêng).
#   - vLLM trên cùng host (bare-metal / docker host network):
#       http://host.docker.internal:8000/v1
#   - vLLM ở container khác, cùng docker network:
#       http://<vllm-container-name>:8000/v1
#   - vLLM ở host khác:
#       http://10.x.x.x:8000/v1  hoặc  https://vllm.internal/v1
VLLM_BASE_URL=http://host.docker.internal:8000/v1

# [REQUIRED] Model đang serve trên vLLM. Phải match --served-model-name bên vLLM.
VLLM_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507-FP8


# ---- RAG feature flag ---------------------------------------------------
# [CHECK] false = bypass rag_search/plan_steps nodes, chat flow đi thẳng generate.
#         Bật lại khi RAG design mới ship.
ENABLE_RAG=false


# ---- Qdrant (compose service) -------------------------------------------
# [CHECK] Giữ nguyên — "qdrant" là service name trong docker-compose.yml
QDRANT_URL=http://qdrant:6333


# ---- HuggingFace cache (cho Embedder: all-MiniLM-L6-v2) ------------------
# [CHECK] LẦN ĐẦU deploy: để =0 để container tải model (~90MB) 1 lần vào volume hf_cache.
#         Sau khi log báo "Embedder initialized.": đổi cả 2 sang =1 rồi `docker compose up -d`.
#         Nếu server không có internet: pre-load cache bằng `docker compose run ...` từ máy có net.
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0


# ---- Code Review markers ------------------------------------------------
# Server stateless — không gọi GitLab. gitlab-review-runner chịu trách nhiệm
# fetch diff & post comment dùng các marker dưới đây.
#
# [CHECK] Marker để upsert comment summary in-place (đừng đổi sau khi đã deploy)
AI_REVIEWER_MARKER=AI_REVIEW_MARKER:v1

# [CHECK] Marker cho inline discussions (dùng để resolve thread cũ ở lần review sau)
AI_REVIEWER_INLINE_MARKER=AI_REVIEW_INLINE:v1

# [CHECK] Số lượng review cũ giữ trong <details>Previous reviews</details>
AI_REVIEWER_KEEP_HISTORY=3


# ---- Review limits ------------------------------------------------------
# [CHECK] Timeout tổng cho 1 request /review/analyze (giây). Quá hạn trả 504.
REVIEW_TIMEOUT_SECS=180

# [CHECK] Timeout 1 lần gọi vLLM (giây)
REVIEW_LLM_TIMEOUT_SECS=60

# [CHECK] Max tokens output của vLLM mỗi file
REVIEW_LLM_MAX_TOKENS=4096

# [CHECK] Max ký tự diff đưa vào LLM mỗi file (truncate inline, không skip)
REVIEW_MAX_DIFF_CHARS_PER_FILE=40000


# =============================================================================
# Translation API (NLLB-200) — [OPT], opt-in
# =============================================================================
# [OPT] Bật endpoint /v1/translate (gọi translation-service riêng).
ENABLE_TRANSLATE=false
# [CHECK] URL tới translation-service (service name trong compose, profile translate).
TRANSLATION_URL=http://translation-service:8100
# [OPT] Timeout 1 request dịch (giây) / max ký tự input.
TRANSLATION_TIMEOUT=60
MAX_TRANSLATE_CHARS=20000


# =============================================================================
# State / scaling — [OPT]
# =============================================================================
# [OPT] Postgres cho metrics + audit + memory. Bỏ trống → fallback SQLite.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/metrics_db
# [OPT] Redis cho session + rate-limit dùng chung (multi-instance, profile scale).
#   Bỏ trống → in-memory (1 instance).
# REDIS_URL=redis://redis:6379/0
# [OPT] Rate limit
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60


# =============================================================================
# Security — [OPT]
# =============================================================================
# [CHECK] Cho phép execute command (run_command/tests/lint). false = chặn hẳn.
EXEC_ENABLED=true
# [OPT] Cô lập exec: none | container (chạy lệnh trong container --network=none).
EXEC_ISOLATION=none
# EXEC_CONTAINER_IMAGE=python:3.12-slim
# EXEC_ALLOW_NPX=false
# [OPT] RBAC: role mặc định cho API key. viewer|developer|admin.
DEFAULT_ROLE=developer
# API_KEY_ROLE=developer
# API_KEY_ROLES={"key1":"admin","key2":"viewer"}


# =============================================================================
# AI engineering / agent — [OPT]
# =============================================================================
# [OPT] A/B test prompt variant (code_gen default vs concise).
ENABLE_AB_PROMPT=false
# [OPT] Thư mục prompt versioned.
PROMPT_CONFIG_DIR=config/prompts
# [OPT] Cross-session memory (Postgres/SQLite). Cân nhắc privacy.
ENABLE_MEMORY=false
# [OPT] LLM response cache (chỉ cache câu trả lời không phụ thuộc repo-context).
ENABLE_LLM_CACHE=true


# =============================================================================
# Reliability / performance — [OPT]
# =============================================================================
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RECOVERY_TIMEOUT=60
VLLM_MAX_CONNECTIONS=100
VLLM_MAX_KEEPALIVE=20
VLLM_TIMEOUT=120
SSE_QUEUE_MAXSIZE=256
# [OPT] Pre-warm vLLM lúc khởi động
SPECULATIVE_PREWARM=false


# =============================================================================
# Observability — [OPT]
# =============================================================================
# [OPT] Bật OTel tracing → Jaeger (profile observability). Bỏ trống = tắt.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=ai-agent


# =============================================================================
# Dev — [OPT]
# =============================================================================
# [OPT] DEV_MODE=true → mock vLLM (chạy/test không cần model server).
DEV_MODE=false
