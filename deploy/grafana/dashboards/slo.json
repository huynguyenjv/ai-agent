{
  "title": "AI Agent — SLO",
  "uid": "ai-agent-slo",
  "schemaVersion": 39,
  "timezone": "browser",
  "refresh": "30s",
  "tags": ["ai-agent", "slo"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Availability (success rate) — SLO 99.9%",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 99 },
            { "color": "green", "value": 99.9 }
          ] }
        }
      },
      "targets": [
        {
          "expr": "100 * sum(rate(ai_agent_requests_total{status=\"success\"}[5m])) / clamp_min(sum(rate(ai_agent_requests_total[5m])), 1)",
          "legendFormat": "availability"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error rate — SLO < 1%",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "red", "value": 5 }
          ] }
        }
      },
      "targets": [
        {
          "expr": "100 * sum(rate(ai_agent_requests_total{status=\"error\"}[5m])) / clamp_min(sum(rate(ai_agent_requests_total[5m])), 1)",
          "legendFormat": "error rate"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Latency P99 — SLO < 10s",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 8 },
            { "color": "red", "value": 10 }
          ] }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(ai_agent_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latency P50/P95/P99",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(ai_agent_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(ai_agent_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(ai_agent_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Error budget burn (errors/min)",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        { "expr": "60 * sum(rate(ai_agent_requests_total{status=\"error\"}[5m]))", "legendFormat": "errors/min" }
      ]
    }
  ]
}
